# Application
APP_ENV=development
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://smartdialer:smartdialer_pass@localhost:5432/smartdialer

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Safety Controller
MAX_DIAL_RATIO=3.0
SAFETY_ABANDONED_THRESHOLD=0.03
PROVIDER_HEALTH_THRESHOLD_REJECT=0.4
PROVIDER_HEALTH_THRESHOLD_REDUCE=0.7

# Worker
HEARTBEAT_INTERVAL_SECONDS=10
HEARTBEAT_TIMEOUT_SECONDS=30
PACING_CYCLE_SECONDS=2

# Dialing
ANSWER_RATE_WINDOW=100
WRAP_UP_SECONDS=30
